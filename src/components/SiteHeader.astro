---
import { siteConfig } from '../../site.config';
import { withBase } from '../lib/url';
import { CATEGORIES, CATEGORY_KEYS, type Category } from '../lib/categories';

interface Props {
  /** 現在表示中のカテゴリ(ナビの現在位置表示に使う) */
  currentCategory?: Category;
}
const { currentCategory } = Astro.props;
---
<header class="sign-bar">
  <div class="container container--wide">
    <a class="brand" href={withBase('/')}>
      <svg class="brand__mark" viewBox="0 0 48 48" aria-hidden="true">
        <path d="M6 27 L20 22 L29 9 L35 9 L30 22 L42 21 Q47 21 47 24 Q47 27 42 27 L30 26 L35 39 L29 39 L20 26 L9 31 Z" fill="#f6c544"></path>
      </svg>
      <span>
        <span class="brand__name">{siteConfig.title}</span>
        <span class="brand__tagline">飛行機旅を少しラクにする情報サイト</span>
      </span>
    </a>
    <nav class="sign-nav" aria-label="カテゴリ">
      {CATEGORY_KEYS.map((key) => (
        <a href={withBase(`/category/${key}/`)} aria-current={key === currentCategory ? 'page' : undefined}>{CATEGORIES[key].label}</a>
      ))}
    </nav>
  </div>
</header>
