---
import type { Category } from '../lib/categories';
import { renderEyecatchSvg } from '../lib/eyecatch';

interface Props {
  category: Category;
  title: string;
  class?: string;
}
const { category, title, class: className } = Astro.props;
---
<div class={className} set:html={renderEyecatchSvg({ category, title })}></div>
